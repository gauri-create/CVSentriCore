# Environment configuration for deployment
# Copy this file and fill in the actual values for your environment

# Database Configuration
DB_USERNAME=cvsentricore_user
DB_PASSWORD=your_secure_password_here
DB_NAME=cvsentricore
DB_HOST=localhost
DB_PORT=3306
DB_ROOT_PASSWORD=root_password_here

# Backend Configuration
SERVER_PORT=8080
JWT_SECRET=your_very_secure_jwt_secret_key_min_32_chars_12345678
JWT_EXPIRATION=86400000

# AI Service Configuration
FLASK_ENV=production
FLASK_PORT=5001
BACKEND_URL=http://localhost:8080

# File Upload
UPLOAD_DIR=/var/uploads/cvsentricore
MAX_FILE_SIZE=52428800

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://your-domain.com

# Admin User
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_secure_password

# Email Configuration (if needed)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# Application Info
APP_NAME=CVSentriCore
APP_VERSION=1.0.0
ENVIRONMENT=production

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/cvsentricore/app.log
